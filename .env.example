# Generate the audit key with: python -c "import secrets; print(secrets.token_hex(32))"
# Never commit a real secret; docker-compose requires AUDIT_SECRET_KEY.
AUDIT_SECRET_KEY=
# Optional separate bearer token for GET /api/audit/logs; disabled when empty.
AUDIT_LOG_ACCESS_TOKEN=
# Only the deterministic mock is implemented; external providers are not integrated.
MODEL_PROVIDER=mock
