# Environment Configuration for Protein Folding Alpha Geometry
# Copy this file to .env and customize for your deployment

# HMAC-SHA256 Audit Trail Secret Key
# IMPORTANT: Set a strong, unique key in production environments.
# If not set, a random ephemeral key will be generated per session.
AUDIT_SECRET_KEY=your-secure-random-key-here

# LLM Provider (mock, ollama, claude, openai)
MODEL_PROVIDER=mock
